# baresip config generated by GoSipTea

poll_method             epoll

# SIP
sip_cafile              /etc/ssl/certs/ca-certificates.crt
sip_capath              /etc/ssl/certs
sip_verify_server       yes
call_local_timeout      120
call_max_calls          1
call_accept             no

# Audio
audio_player            pipewire
audio_source            pipewire
audio_alert             pipewire
audio_telev_pt          101

# RTP
rtp_tos                 184
audio_jitter_buffer_type        fixed
audio_jitter_buffer_ms  100-200

# Modules
module_path             /usr/lib/baresip/modules
module                  g711.so
module                  opus.so
module                  auconv.so
module                  auresamp.so
module                  pipewire.so
module                  webrtc_aec.so
module                  srtp.so
module                  uuid.so
module                  stun.so

module_app              account.so
module_app              contact.so
module_app              debug_cmd.so
module_app              menu.so
module_app              netroam.so
module_app              ctrl_dbus.so

# Local control
ctrl_dbus_use           session
